# Deepgram API key for speech-to-text on patient mode
VITE_DEEPGRAM_KEY=your_deepgram_api_key_here

# AWS API Gateway base URL
VITE_API_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com/prod

# Google Maps Embed API key (for map iframe in patient mode)
# Get one at https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_KEY=your_google_maps_embed_api_key_here
