# Sahay Frontend Environment Variables
# Copy this to .env.local and fill in your values after cdk deploy

# API Gateway URL — from CDK output "ApiUrl"
VITE_API_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com/prod

# Cognito — from CDK outputs
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_AWS_REGION=ap-south-1
